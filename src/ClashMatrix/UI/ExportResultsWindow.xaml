<Window x:Class="ClashMatrix.UI.ExportResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ClashMatrix.UI"
        Title="Export Clash Results"
        Width="980" Height="820" MinWidth="820" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <!-- The look comes from MhTheme.Apply (UI/MhTheme.cs, UI/Theme.xaml): styles named
         Mh... are used with DynamicResource; this file only sets layout. -->

    <Grid>
        <Grid.Resources>
            <Style x:Key="CellText" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <Style.Triggers>
                    <Trigger Property="Text" Value="">
                        <Setter Property="ToolTip" Value="{x:Null}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="Margin" Value="0,3,18,3" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:MhHeader Grid.Row="0" Title="Export Clash Results"
                     Subtitle="Clash Detective results to Excel and a PDF report - choose the tests, the contents and the statuses, as in Clash Detective's own Report." />

        <Grid Grid.Row="1" Margin="20,16,20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="160" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- which tests -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Style="{DynamicResource MhSectionText}" Text="Clash tests"
                           VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Left" x:Name="SelectionText" Style="{DynamicResource MhMutedText}"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{DynamicResource MhCompactButton}" Content="All" Click="All_Click" />
                    <Button Style="{DynamicResource MhCompactButton}" Content="None" Click="None_Click" Margin="6,0,0,0" />
                    <Button Style="{DynamicResource MhCompactButton}" Content="Clash Matrix tests" Click="ClashMatrix_Click" Margin="6,0,0,0"
                            ToolTip="Only the tests whose two sides are linked to the 'Clash Matrix' search sets." />
                    <Button Style="{DynamicResource MhCompactButton}" Content="With clashes" Click="WithClashes_Click" Margin="6,0,0,0"
                            ToolTip="Only the tests that have at least one result." />
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1" Style="{DynamicResource MhTableFrame}">
                <DataGrid x:Name="TestsGrid"
                          BorderThickness="0"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Extended"
                          HeadersVisibility="Column"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="44" CanUserResize="False" SortMemberPath="IsSelected">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Click="Tick_Click" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Clash test" Width="*" MinWidth="220" IsReadOnly="True"
                                            Binding="{Binding Name}" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Status" Width="90" IsReadOnly="True"
                                            Binding="{Binding Status}" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Clashes" Width="80" IsReadOnly="True"
                                            Binding="{Binding Total}" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Open" Width="70" IsReadOnly="True"
                                            Binding="{Binding Open}" ElementStyle="{StaticResource CellText}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- what to write: as Clash Detective's own Report dialog -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0" Header="Contents" Margin="0,0,12,0">
                    <StackPanel>
                        <UniformGrid x:Name="ContentsPanel" Columns="3" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Style="{DynamicResource MhCompactButton}" Content="All" Click="ContentsAll_Click" />
                            <Button Style="{DynamicResource MhCompactButton}" Content="None" Click="ContentsNone_Click" Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <StackPanel Grid.Column="1">
                    <GroupBox Header="Include clashes">
                        <StackPanel x:Name="StatusPanel" />
                    </GroupBox>
                    <GroupBox Header="Output" Margin="0,8,0,0">
                        <StackPanel>
                            <CheckBox x:Name="ExcelBox" Content="Excel workbook (.xlsx)" IsChecked="True" />
                            <CheckBox x:Name="PdfBox" Content="PDF report" IsChecked="True" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </Grid>

            <!-- where -->
            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{DynamicResource MhFieldLabel}" Text="Save as" />
                <TextBox Grid.Column="1" x:Name="PathBox" VerticalContentAlignment="Center"
                         ToolTip="The .xlsx and the .pdf get this name, side by side." />
                <Button Grid.Column="2" Style="{DynamicResource MhCompactButton}" Content="Browse..." Margin="8,0,0,0"
                        Click="Browse_Click" />
            </Grid>
        </Grid>

        <ui:MhFooter Grid.Row="2" x:Name="Footer">
            <ui:MhFooter.Actions>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ExportButton" Style="{DynamicResource MhPrimaryButton}" Content="Export"
                            Click="Export_Click" />
                    <Button Content="Close" Margin="8,0,0,0" Click="Close_Click" />
                </StackPanel>
            </ui:MhFooter.Actions>
        </ui:MhFooter>
    </Grid>
</Window>
