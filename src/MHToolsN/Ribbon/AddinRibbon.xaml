<?xml version="1.0" encoding="utf-8" ?>
<!-- Navisworks ribbon definition. The RibbonTab Id must match [RibbonTab] in App.cs,
     and every NWRibbonButton Id a [Command] name there. -->
<RibbonControl
    x:Uid="MHToolsN" xmlns="clr-namespace:Autodesk.Windows;assembly=AdWindows"
    xmlns:wpf="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:adwi="clr-namespace:Autodesk.Internal.Windows;assembly=AdWindows"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Autodesk.Navisworks.Gui.Roamer.AIRLook;assembly=navisworks.gui.roamer">

    <RibbonTab Id="MHToolsN" KeyTip="T1">

        <RibbonPanel x:Uid="RibbonPanel_Clash">
            <RibbonPanelSource x:Uid="RibbonPanelSource_Clash" KeyTip="C1" Title="Clash">

                <local:NWRibbonButton x:Uid="Clash Matrix Import" Id="MHToolsN.ClashMatrix"
                            Size="Large"
                            KeyTip="M"
                            ShowText="True"
                            Text="Clash&#10;Matrix"
                            Orientation="Vertical"
                />

                <local:NWRibbonButton x:Uid="Clash Matrix Export Results" Id="MHToolsN.ExportResults"
                            Size="Large"
                            KeyTip="E"
                            ShowText="True"
                            Text="Export&#10;Results"
                            Orientation="Vertical"
                />

            </RibbonPanelSource>
        </RibbonPanel>

        <RibbonPanel x:Uid="RibbonPanel_Quantities">
            <RibbonPanelSource x:Uid="RibbonPanelSource_Quantities" KeyTip="Q1" Title="Quantities">

                <local:NWRibbonButton x:Uid="MHToolsN Quantities" Id="MHToolsN.Quantities"
                            Size="Large"
                            KeyTip="Q"
                            ShowText="True"
                            Text="Quantities"
                            Orientation="Vertical"
                />

            </RibbonPanelSource>
        </RibbonPanel>

        <RibbonPanel x:Uid="RibbonPanel_AiBridge">
            <RibbonPanelSource x:Uid="RibbonPanelSource_AiBridge" KeyTip="B1" Title="AI Bridge">

                <local:NWRibbonButton x:Uid="MHToolsN Agent Bridge" Id="MHToolsN.AgentBridge"
                            Size="Large"
                            KeyTip="B"
                            ShowText="True"
                            Text="Agent Bridge&#10;Off"
                            Orientation="Vertical"
                />

                <local:NWRibbonButton x:Uid="MHToolsN Trusted Code" Id="MHToolsN.TrustedCode"
                            Size="Large"
                            KeyTip="T"
                            ShowText="True"
                            Text="Trusted C#&#10;Off"
                            Orientation="Vertical"
                />

                <local:NWRibbonButton x:Uid="MHToolsN Connect AI" Id="MHToolsN.ConnectAi"
                            Size="Large"
                            KeyTip="I"
                            ShowText="True"
                            Text="Connect&#10;AI"
                            Orientation="Vertical"
                />

            </RibbonPanelSource>
        </RibbonPanel>

        <RibbonPanel x:Uid="RibbonPanel_Help">
            <RibbonPanelSource x:Uid="RibbonPanelSource_Help" KeyTip="H1" Title="Help">

                <local:NWRibbonButton x:Uid="Clash Matrix About" Id="MHToolsN.About"
                            Size="Large"
                            KeyTip="A"
                            ShowText="True"
                            Text="About"
                            Orientation="Vertical"
                />

            </RibbonPanelSource>
        </RibbonPanel>

    </RibbonTab>

</RibbonControl>
