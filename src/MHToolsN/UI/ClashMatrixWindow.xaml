<Window x:Class="MHToolsN.UI.ClashMatrixWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MHToolsN.UI"
        Title="Clash Matrix"
        Width="1080" Height="860" MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <!--
        The look is not in this file. Colours, fonts and the styles named
        Mh... come from UI/MhTheme.cs and UI/Theme.xaml (the MH Tools theme),
        given to the window by MhTheme.Apply in the code-behind - which is why
        they are used with DynamicResource here, never StaticResource. What IS
        set here is layout: margins, widths, and wrapping.
    -->

    <Grid>
        <!-- The window's own resources are here, not in Window.Resources: that
             is where MhTheme.Apply puts the theme. -->
        <Grid.Resources>
            <!-- Grid cells: trim with an ellipsis, and hand back the full value on hover. -->
            <Style x:Key="CellText" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <Style.Triggers>
                    <Trigger Property="Text" Value="">
                        <Setter Property="ToolTip" Value="{x:Null}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- The box a cell is edited in: the theme's text box. -->
            <Style x:Key="CellEditText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}" />
            <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                <Setter Property="Margin" Value="0,0,20,0" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== header ===== -->
        <ui:MhHeader Grid.Row="0" Title="Clash Matrix"
                     Subtitle="Search sets and clash tests from a clash matrix. Sets live in a 'Clash Matrix' folder; only tests linked to those sets are ever changed." />

        <!-- ===== body ===== -->
        <Grid Grid.Row="1" Margin="20,14,20,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- matrix source and its files -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{DynamicResource MhFieldLabel}" Text="Matrix" />
                <TextBox Grid.Column="1" x:Name="PathText" IsReadOnly="True" Text="(none)" VerticalContentAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Style="{DynamicResource MhCompactButton}" Content="Import Matrix..." Click="ImportMatrix_Click"
                            ToolTip="Load an Excel clash matrix (.xlsx). Nothing in the model changes until you create the sets and tests." />
                    <Button x:Name="ExportButton" Style="{DynamicResource MhCompactButton}" Margin="6,0,0,0"
                            Content="Export Matrix..." Click="ExportMatrix_Click"
                            ToolTip="Write the current matrix (what is ticked) to Excel, to edit and import again." />
                    <Button x:Name="XmlButton" Style="{DynamicResource MhCompactButton}" Margin="6,0,0,0"
                            Content="Generate XML..." Click="GenerateXml_Click"
                            ToolTip="Write the Navisworks exchange file for Clash Detective > Batch > Import." />
                </StackPanel>
            </Grid>

            <TabControl Grid.Row="1" x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">

                <!-- ================= Search Sets ================= -->
                <TabItem Header="Search Sets">
                    <Grid Margin="14,14,14,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="140" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- models and their disciplines -->
                        <Grid Grid.Row="0" x:Name="ModelsPanel" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,6,8,0">
                                <TextBlock Style="{DynamicResource MhFieldLabel}" Text="Models" />
                                <TextBlock Style="{DynamicResource MhMutedText}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11"
                                           Text="Discipline of each file. Change it if the guess is wrong." />
                            </StackPanel>
                            <Border Grid.Column="1" Style="{DynamicResource MhTableFrame}">
                                <DataGrid x:Name="ModelsGrid" BorderThickness="0" AutoGenerateColumns="False"
                                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                                          SelectionMode="Single" HeadersVisibility="Column" MaxHeight="185"
                                          VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Model file" Width="*" MinWidth="200" IsReadOnly="True"
                                                            Binding="{Binding FileName}" ElementStyle="{StaticResource CellText}" />
                                        <DataGridTextColumn Header="Content" Width="110" IsReadOnly="True"
                                                            Binding="{Binding CategorySummary}" ElementStyle="{StaticResource CellText}" />
                                        <DataGridTemplateColumn Header="Discipline" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding Choices}" Margin="2"
                                                              SelectedItem="{Binding Discipline, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              SelectionChanged="Discipline_Changed"
                                                              ToolTip="AR architecture, ST structure, MEC mechanical, EL electrical, ICT information &amp; communication. EL+ICT: an electrical file with the ICT devices (split by category). MEP: one file with all services (split into MEC / EL / ICT). GEN: general." />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>

                        <!-- how sets are made -->
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{DynamicResource MhFieldLabel}" Text="Sets" VerticalAlignment="Top" Margin="0,2,8,0" />
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="BestPracticeBox" GroupName="Mode" IsChecked="True" Content="Best practice"
                                                 Checked="Mode_Changed"
                                                 ToolTip="Each discipline keeps only its own categories: no AR Plumbing Fixtures, EL Ducts or MEC Cable Trays. Those elements are left out (and listed)." />
                                    <RadioButton x:Name="AllCategoriesBox" GroupName="Mode" Content="All categories"
                                                 Checked="Mode_Changed"
                                                 ToolTip="Every category in every file gets a set, as the files hold them - AR Plumbing Fixtures and MEC Cable Trays included." />
                                </StackPanel>
                                <TextBlock x:Name="SetsSummary" Style="{DynamicResource MhMutedText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="Scan Model lists the sets for the appended files; tick, rename or edit them, then Create Search Sets." />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button x:Name="ScanButton" Style="{DynamicResource MhCompactButton}" Content="Scan Model" Click="ScanModel_Click"
                                        ToolTip="Read the appended files and list one set per discipline and category, with the default tests. Nothing in the model changes yet." />
                                <Button x:Name="CountButton" Style="{DynamicResource MhCompactButton}" Content="Count Items" Click="CountItems_Click" Margin="6,0,0,0"
                                        ToolTip="Count the items each existing set finds - an empty set stands out." />
                            </StackPanel>
                        </Grid>

                        <!-- the sets -->
                        <DockPanel Grid.Row="2">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBox x:Name="SetsSearch" VerticalContentAlignment="Center" TextChanged="SetsSearch_Changed"
                                         ToolTip="Filter the sets by name, discipline, Revit category or file. The header tick box acts on what is shown." />
                                <TextBlock x:Name="SetsSearchHint" Text="Search..." Style="{DynamicResource MhMutedText}"
                                           IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </Grid>
                        <Border Style="{DynamicResource MhTableFrame}">
                            <DataGrid x:Name="SetsGrid" BorderThickness="0" AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column"
                                      EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      PreviewMouseLeftButtonDown="Grid_PreviewMouseLeftButtonDown">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="44" CanUserResize="False" SortMemberPath="Include">
                                        <DataGridTemplateColumn.Header>
                                            <CheckBox x:Name="SetsAllBox" Margin="2,0,0,0" Click="SetsAllBox_Click"
                                                      ToolTip="Tick or untick every set shown (what the search lets through)." />
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"
                                                          IsChecked="{Binding Include, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Click="SetBox_Click"
                                                          ToolTip="Unticked: not created (and deleted from the model on Create Search Sets), and its tests are left out. With several rows selected, ticks or unticks them all." />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Search set" Width="220" MinWidth="120"
                                                        Binding="{Binding Name, Mode=TwoWay}"
                                                        ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEditText}" />
                                    <DataGridTextColumn Header="Disc." Width="56" IsReadOnly="True"
                                                        Binding="{Binding Discipline}" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Revit categories" Width="*" MinWidth="180"
                                                        Binding="{Binding Categories, Mode=TwoWay}"
                                                        ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEditText}" />
                                    <DataGridTemplateColumn Header="Files" Width="80" SortMemberPath="Files">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Files}" ToolTip="{Binding FilesTip}" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Status" Width="90" IsReadOnly="True"
                                                        Binding="{Binding Status}" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Items" Width="70" IsReadOnly="True"
                                                        Binding="{Binding Items}" ElementStyle="{StaticResource CellText}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        </DockPanel>

                        <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Style="{DynamicResource MhMutedText}" VerticalAlignment="Center"
                                       Text="Header tick box: all shown. Several rows selected: ticking one ticks them all." />
                            <Button DockPanel.Dock="Right" x:Name="CreateSetsButton" Style="{DynamicResource MhCompactButton}"
                                    Content="Create Search Sets" Click="CreateSets_Click"
                                    ToolTip="Create the ticked sets (existing ones are updated in place, so tests stay linked) and delete the unticked ones that exist. You confirm first." />
                        </DockPanel>
                    </Grid>
                </TabItem>

                <!-- ================= Clash Tests ================= -->
                <TabItem Header="Clash Tests">
                    <Grid Margin="14,14,14,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="140" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{DynamicResource MhFieldLabel}" Text="Tolerance (mm)" />
                            <TextBox Grid.Column="1" x:Name="ToleranceText" Width="80" Text="10" VerticalContentAlignment="Center"
                                     TextChanged="Tolerance_Changed"
                                     ToolTip="For every test whose tolerance says 'default'. 0 is allowed." />
                            <TextBlock Grid.Column="2" x:Name="SummaryText" Style="{DynamicResource MhMutedText}"
                                       VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap" Text="No matrix yet." />
                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <Button Style="{DynamicResource MhCompactButton}" Content="Renumber" Click="Renumber_Click"
                                        ToolTip="Number and name the tests again in matrix order (names you typed are kept)." />
                            </StackPanel>
                        </Grid>

                        <DockPanel Grid.Row="1">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBox x:Name="TestsSearch" VerticalContentAlignment="Center" TextChanged="TestsSearch_Changed"
                                         ToolTip="Filter the tests by name or by either set. The header tick box acts on what is shown." />
                                <TextBlock x:Name="TestsSearchHint" Text="Search..." Style="{DynamicResource MhMutedText}"
                                           IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </Grid>
                        <Border Style="{DynamicResource MhTableFrame}">
                            <DataGrid x:Name="TestsGrid" BorderThickness="0" AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column"
                                      EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      PreviewMouseLeftButtonDown="Grid_PreviewMouseLeftButtonDown">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="44" CanUserResize="False" SortMemberPath="Include">
                                        <DataGridTemplateColumn.Header>
                                            <CheckBox x:Name="TestsAllBox" Margin="2,0,0,0" Click="TestsAllBox_Click"
                                                      ToolTip="Tick or untick every test shown (what the search lets through)." />
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"
                                                          IsChecked="{Binding Include, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding SetsIncluded}"
                                                          Click="TestBox_Click"
                                                          ToolTip="Unticked: not created (an existing one can be removed when you create the tests). With several rows selected, ticks or unticks them all." />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Test name" Width="*" MinWidth="200"
                                                        Binding="{Binding Name, Mode=TwoWay}"
                                                        ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEditText}" />
                                    <DataGridTextColumn Header="Left" Width="170" IsReadOnly="True"
                                                        Binding="{Binding LeftName}" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Right" Width="170" IsReadOnly="True"
                                                        Binding="{Binding RightName}" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Tol (mm)" Width="72"
                                                        Binding="{Binding Tolerance, Mode=TwoWay}"
                                                        ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEditText}" />
                                    <DataGridTextColumn Header="Tol." Width="60" IsReadOnly="True"
                                                        Binding="{Binding ToleranceSource}" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTemplateColumn Header="Priority" Width="104" SortMemberPath="Priority">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding Priorities}" Margin="2"
                                                          SelectedItem="{Binding Priority, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Status" Width="96" IsReadOnly="True"
                                                        Binding="{Binding Status}" ElementStyle="{StaticResource CellText}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        </DockPanel>

                        <TextBlock Grid.Row="2" Style="{DynamicResource MhMutedText}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="Double-click a name or a tolerance to edit it. Create Clash Tests creates the ticked tests and their sets; you confirm first." />
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- warnings -->
            <Border Grid.Row="2" x:Name="WarningsPanel" Style="{DynamicResource MhNotePanel}" Margin="0,10,0,0"
                    Visibility="Collapsed">
                <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <TextBlock x:Name="WarningsText" TextWrapping="Wrap" Foreground="{DynamicResource MhWarningBrush}" />
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ===== signature, status and buttons ===== -->
        <ui:MhFooter Grid.Row="2" x:Name="Footer">
            <ui:MhFooter.Actions>
                <StackPanel Orientation="Horizontal">
                    <!-- One step at a time: on Search Sets this is "Next", on Clash Tests "Create Clash Tests" (see UpdateFooter). -->
                    <Button x:Name="BackButton" Content="&#x2190;  Back" Click="Back_Click" Margin="0,0,8,0" Visibility="Collapsed"
                            ToolTip="Back to the Search Sets tab." />
                    <Button x:Name="CreateTestsButton" Style="{DynamicResource MhPrimaryButton}"
                            Content="Next: Clash Tests  &#x2192;" Click="Primary_Click" />
                    <!-- No IsCancel: Esc must cancel a cell edit in the tables, not close the window. -->
                    <Button Content="Close" Margin="8,0,0,0" Click="Close_Click" />
                </StackPanel>
            </ui:MhFooter.Actions>
        </ui:MhFooter>
    </Grid>
</Window>
