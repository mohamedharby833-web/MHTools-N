<Window x:Class="MHToolsN.UI.TrustedCodeWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MHToolsN.UI"
        Title="MHTools-N - Allow generated C#"
        Width="560" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <!--
        Switches Trusted C# on, in Ask or Auto mode - the same window as
        MHTools-R's. The mode is picked first and confirmed with Turn on, so a
        click shows what it chose before anything changes. Cancel is the default
        button: Enter, Esc and the X all leave it off. The look comes from
        MhTheme.Apply.
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:MhHeader Grid.Row="0" Title="Allow generated C#"
                     Subtitle="Let connected agents run generated C# in this Navisworks?" />

        <StackPanel Grid.Row="1" Margin="20,16,20,16">
            <TextBlock Style="{DynamicResource MhMutedText}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="The code runs inside Navisworks with your Windows permissions. It can change the model and reach files and the network - it is not sandboxed. Every change is one undoable step (Ctrl+Z), and the bridge never saves the file." />
            <TextBlock Style="{DynamicResource MhMutedText}" TextWrapping="Wrap" Margin="0,0,0,14"
                       Text="Off, agents only read the model and change the view. On, they may also save sets and viewpoints, change clash statuses, run clash tests, build the Clash Matrix, fill in Quantification and run C#. This stays on until you switch it off or stop the bridge." />

            <!-- A card per mode: the whole card picks it, and the picked one is
                 outlined in the accent (code-behind, Mark). -->
            <Border x:Name="AskCard" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8"
                    Cursor="Hand" MouseLeftButtonUp="OnPickAsk">
                <RadioButton x:Name="AskOption" Style="{DynamicResource MhRadioButton}" GroupName="Mode"
                             IsChecked="True" Margin="14,10" Checked="OnModeChanged">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource MhStrongText}" Text="Ask before each change (recommended)" />
                        <TextBlock Style="{DynamicResource MhMutedText}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Text="Before each change Navisworks shows what the agent wants to do - the code, for C# - and does it only if you say Yes." />
                    </StackPanel>
                </RadioButton>
            </Border>

            <Border x:Name="AutoCard" BorderThickness="1" CornerRadius="4"
                    Cursor="Hand" MouseLeftButtonUp="OnPickAuto">
                <RadioButton x:Name="AutoOption" Style="{DynamicResource MhRadioButton}" GroupName="Mode"
                             Margin="14,10" Checked="OnModeChanged">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource MhStrongText}" Text="Auto - keep changes without asking" />
                        <TextBlock Style="{DynamicResource MhMutedText}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Text="The agent works on its own. Use it on a copy of the model, not a live coordination file." />
                    </StackPanel>
                </RadioButton>
            </Border>
        </StackPanel>

        <ui:MhFooter Grid.Row="2" Status="Generated C# stays off until you turn it on.">
            <ui:MhFooter.Actions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Cancel" IsDefault="True" IsCancel="True" Margin="0,0,8,0" />
                    <Button Style="{DynamicResource MhPrimaryButton}" Content="Turn on" Click="OnTurnOn" />
                </StackPanel>
            </ui:MhFooter.Actions>
        </ui:MhFooter>
    </Grid>
</Window>
