<Window x:Class="MHToolsN.UI.TrustedCodeWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MHToolsN.UI"
        Title="MHTools-N - Trusted C#"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <!-- Only one of the two choices switches Trusted C# on; closing the window
         or Cancel leaves it off. The look comes from MhTheme.Apply. -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:MhHeader Grid.Row="0" Title="Trusted C#"
                     Subtitle="Let connected AI apps change this Navisworks model?" />

        <StackPanel Grid.Row="1" Margin="20,16,20,16">
            <TextBlock Style="{DynamicResource MhMutedText}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="With this off, an AI app can read the model and change only the view (selection, zoom, hiding, temporary colours). With it on, it may also change the model: save sets and viewpoints, change clash statuses, assignees and comments, run clash tests, build the Clash Matrix - and run C# it writes itself." />
            <TextBlock Style="{DynamicResource MhMutedText}" TextWrapping="Wrap" Margin="0,0,0,14"
                       Text="C# runs inside Navisworks with your Windows permissions and is not sandboxed. Every change is one undoable step (Ctrl+Z), and the bridge never saves the file. This stays on until you switch it off, stop the Agent Bridge or close Navisworks." />

            <Button x:Name="AskButton" Style="{DynamicResource MhPrimaryButton}" HorizontalContentAlignment="Left"
                    Padding="14,8" Click="OnAsk" Height="Auto">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Ask before each change (recommended)" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.9"
                               Text="Before each change Navisworks tells you what the AI wants to do, and does it only if you say Yes." />
                </StackPanel>
            </Button>

            <Button Margin="0,10,0,0" HorizontalContentAlignment="Left" Padding="14,8" Click="OnAuto" Height="Auto">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Auto - keep changes without asking" />
                    <TextBlock Style="{DynamicResource MhMutedText}" TextWrapping="Wrap"
                               Text="The AI works on its own. Use it on a copy of the model, not a live coordination file." />
                </StackPanel>
            </Button>
        </StackPanel>

        <ui:MhFooter Grid.Row="2">
            <ui:MhFooter.Actions>
                <Button Content="Cancel" IsCancel="True" Click="OnCancel" />
            </ui:MhFooter.Actions>
        </ui:MhFooter>
    </Grid>
</Window>
