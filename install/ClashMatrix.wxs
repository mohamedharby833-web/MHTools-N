<?xml version="1.0" encoding="utf-8"?>
<!--
  Clash Matrix installer.

  Per-user: everything lands in %AppData%\Autodesk\ApplicationPlugins\ClashMatrix.bundle,
  which Navisworks scans alongside the all-users ProgramData location. No admin rights,
  no IT ticket - a colleague double-clicks the MSI and it is done.

  One bundle covers Navisworks Manage 2024, 2025, 2026 and 2027. Navisworks reads
  PackageContents.xml and loads only the build whose SeriesMin matches the release
  being started, so having all four on disk is harmless.

  Files.wxs is generated by build-installer.ps1 from whatever the builds produced.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Clash Matrix for Navisworks"
           Manufacturer="Mohamed Ali Harby"
           Version="$(var.ProductVersion)"
           UpgradeCode="ce45b324-da3e-43b1-bac1-fad3e9053cdc"
           Scope="perUser"
           Compressed="yes">

    <SummaryInformation Description="Navisworks Manage add-in: generates clash tests from an Excel clash matrix" />

    <!--
      Installing a newer build replaces the old one rather than stacking up.
      AllowSameVersionUpgrades: a rebuild at the SAME version (a fix sent out
      before the number was bumped) also replaces the installed one. Without it
      Apps and features gained a second entry and the fix never reached disk.
    -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of Clash Matrix is already installed. Remove it first from Apps and features." />

    <!--
      Never offer to close Navisworks. Restart Manager's default is to offer closing
      the applications holding the add-in's files - with a large model open, that is
      an offer to lose unsaved work. Disabled, a Navisworks that is open gives the
      plain "files in use" prompt: close Navisworks yourself, then Retry.
    -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="ClashMatrixIcon" SourceFile="icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="ClashMatrixIcon" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <!-- %AppData%\Autodesk\ApplicationPlugins\ClashMatrix.bundle -->
    <StandardDirectory Id="AppDataFolder">
      <Directory Id="AutodeskDir" Name="Autodesk">
        <Directory Id="AppPluginsDir" Name="ApplicationPlugins">
          <Directory Id="INSTALLFOLDER" Name="ClashMatrix.bundle" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="Clash Matrix" Level="1">
      <ComponentGroupRef Id="BundleFiles" />
    </Feature>

    <!--
      The install wizard needs the WiX UI extension, which is a separate download.
      build-installer.ps1 defines UseUI only when it managed to add that extension,
      so a machine that cannot reach NuGet still produces a working MSI - it just
      installs with a progress bar instead of a licence page.
    -->
    <?ifdef UseUI ?>
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />
    <ui:WixUI Id="WixUI_Minimal" InstallDirectory="INSTALLFOLDER" />
    <?endif?>

  </Package>
</Wix>
