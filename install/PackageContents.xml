<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!--
  Autodesk Navisworks bundle manifest (per-user install, no admin rights).

  Installed to:  %AppData%\Autodesk\ApplicationPlugins\MHTools-N.bundle\

  One Components block per Navisworks release. Navisworks matches SeriesMin /
  SeriesMax against the release being started and loads only that ComponentEntry,
  which is why several builds can sit in one bundle.

  Navisworks release -> NwNN mapping (NN = year - 2003):
    2024 -> Nw21  2025 -> Nw22  2026 -> Nw23  2027 -> Nw24
-->
<ApplicationPackage SchemaVersion="1.0"
                    AutodeskProduct="Naviswork"
                    ProductType="Application"
                    FriendlyVersion="1.0.0"
                    AppVersion="1.0.0"
                    SupportedLocales="Enu"
                    Name="MHTools-N"
                    Description="MHTools-N for Navisworks: Clash Matrix, Export Results"
                    Author="Mohamed Ali Harby">

  <CompanyDetails Name="Mohamed Ali Harby" />

  <Components Description="Navisworks 2024">
    <RuntimeRequirements OS="Win64" Platform="NAVMAN|NAVSIM" SeriesMin="Nw21" SeriesMax="Nw21" />
    <ComponentEntry AppName="MHTools-N" AppType="ManagedPlugin" Version="1.0.0"
                    ModuleName="./Contents/21/MHTools-N.dll"
                    AppDescription="MHTools-N for Navisworks" />
  </Components>

  <Components Description="Navisworks 2025">
    <RuntimeRequirements OS="Win64" Platform="NAVMAN|NAVSIM" SeriesMin="Nw22" SeriesMax="Nw22" />
    <ComponentEntry AppName="MHTools-N" AppType="ManagedPlugin" Version="1.0.0"
                    ModuleName="./Contents/22/MHTools-N.dll"
                    AppDescription="MHTools-N for Navisworks" />
  </Components>

  <Components Description="Navisworks 2026">
    <RuntimeRequirements OS="Win64" Platform="NAVMAN|NAVSIM" SeriesMin="Nw23" SeriesMax="Nw23" />
    <ComponentEntry AppName="MHTools-N" AppType="ManagedPlugin" Version="1.0.0"
                    ModuleName="./Contents/23/MHTools-N.dll"
                    AppDescription="MHTools-N for Navisworks" />
  </Components>

  <Components Description="Navisworks 2027">
    <RuntimeRequirements OS="Win64" Platform="NAVMAN|NAVSIM" SeriesMin="Nw24" SeriesMax="Nw24" />
    <ComponentEntry AppName="MHTools-N" AppType="ManagedPlugin" Version="1.0.0"
                    ModuleName="./Contents/24/MHTools-N.dll"
                    AppDescription="MHTools-N for Navisworks" />
  </Components>

</ApplicationPackage>
